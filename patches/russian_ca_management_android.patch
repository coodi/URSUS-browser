+package org.chromium.chrome.browser.ssl;
+
+import android.content.Context;
+
+import org.jni_zero.CalledByNative;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.settings.SettingsNavigationFactory;
+import org.chromium.ui.base.WindowAndroid;
+
+/** Bridge between native SSL interstitial code and Russian certificate settings. */
+@NullMarked
+public class RussianCertificateSettingsNavigation {
+    private RussianCertificateSettingsNavigation() {}
+
+    @CalledByNative
+    private static void showRussianCertificateSettings(WindowAndroid window) {
+        if (window == null) return;
+        Context currentContext = window.getContext().get();
+        if (currentContext == null) return;
+        SettingsNavigationFactory.createSettingsNavigation()
+                .startSettings(currentContext, RussianCertificateSettingsFragment.class);
+    }
+}
