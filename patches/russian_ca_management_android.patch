+bool CertificateListContainsBundledRussianRoot(
+    const net::X509Certificate* certificate) {
+  if (!certificate) {
+    return false;
+  }
+  for (const auto& cert_buffer : certificate->cert_buffers()) {
+    if (russian_ca::IsBundledTrustedRoot(
+            net::x509_util::CryptoBufferAsSpan(cert_buffer.get()))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsRussianRootDisabledError(Profile* profile, const net::SSLInfo& ssl_info) {
+  if (!profile || profile->GetPrefs()->GetBoolean(prefs::kRussianCAEnabled)) {
+    return false;
+  }
+  return CertificateListContainsBundledRussianRoot(ssl_info.unverified_cert.get()) ||
+         CertificateListContainsBundledRussianRoot(ssl_info.cert.get());
+}
+
 }  // namespace
 
