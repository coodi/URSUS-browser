+bool LocationBarModelAndroid::IsUsingRussianTrustedRoot(JNIEnv* env) const {
+  content::WebContents* web_contents = GetActiveWebContents();
+  if (!web_contents) {
+    return false;
+  }
+
+  std::unique_ptr<security_state::VisibleSecurityState> state =
+      security_state::GetVisibleSecurityState(web_contents);
+  if (!state->connection_info_initialized || !state->certificate) {
+    return false;
+  }
+
+  for (const auto& cert_buffer : state->certificate->cert_buffers()) {
+    if (russian_ca::IsBundledTrustedRoot(
+            net::x509_util::CryptoBufferAsSpan(cert_buffer.get()))) {
+      return true;
+    }
+  }
+
+  return false;
+}
