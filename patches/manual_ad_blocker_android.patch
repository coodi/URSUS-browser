--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/adblock/ManualAdBlocker.java
@@ -0,0 +1,346 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.adblock;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.Toast;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.NativeMethods;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.JavaScriptCallback;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+/** Manual cosmetic element blocking for URSUS browser. */
+@NullMarked
+public final class ManualAdBlocker {
+    private static final String PREFS_NAME = "ursus_manual_ad_blocker";
+    private static final String LAST_SELECTOR_KEY = "__ursusManualBlockerLastSelector";
+    private static final int MAX_RULES_PER_ORIGIN = 200;
+    private static final int POLL_ATTEMPTS = 480;
+    private static final long POLL_DELAY_MS = 250;
+
+    private ManualAdBlocker() {}
+
+    public static boolean canBlockElements(@Nullable Tab tab) {
+        return tab != null
+                && tab.isInitialized()
+                && !tab.isDestroyed()
+                && tab.getWebContents() != null
+                && !tab.getWebContents().isDestroyed()
+                && !tab.isNativePage()
+                && !tab.isShowingErrorPage()
+                && isSupportedUrl(tab.getUrl());
+    }
+
+    public static boolean hasRules(@Nullable Tab tab) {
+        if (!canBlockElements(tab)) return false;
+
+        assert tab != null;
+        String origin = getOrigin(tab.getUrl());
+        return !origin.isEmpty() && getRulesForOrigin(origin).length() > 0;
+    }
+
+    public static void startElementBlocking(Context context, @Nullable Tab tab) {
+        if (!canBlockElements(tab)) {
+            Toast.makeText(context, R.string.ursus_element_blocker_unavailable, Toast.LENGTH_SHORT)
+                    .show();
+            return;
+        }
+
+        assert tab != null;
+        WebContents webContents = tab.getWebContents();
+        assert webContents != null;
+        String origin = getOrigin(tab.getUrl());
+        if (origin.isEmpty()) return;
+
+        new Handler(Looper.getMainLooper())
+                .post(
+                        () -> {
+                            if (!canBlockElements(tab)) {
+                                Toast.makeText(
+                                                context,
+                                                R.string.ursus_element_blocker_unavailable,
+                                                Toast.LENGTH_SHORT)
+                                        .show();
+                                return;
+                            }
+                            WebContents currentWebContents = tab.getWebContents();
+                            if (currentWebContents == null) return;
+                            executePageScript(
+                                    currentWebContents, getStartPickerScript(context), null);
+                            Toast.makeText(
+                                            context,
+                                            R.string.ursus_element_blocker_pick_hint,
+                                            Toast.LENGTH_LONG)
+                                    .show();
+                            pollForSelection(
+                                    context.getApplicationContext(), tab, origin, POLL_ATTEMPTS);
+                        });
+    }
+
+    public static void showAll(Context context, @Nullable Tab tab) {
+        if (!canBlockElements(tab)) {
+            Toast.makeText(context, R.string.ursus_element_blocker_unavailable, Toast.LENGTH_SHORT)
+                    .show();
+            return;
+        }
+
+        assert tab != null;
+        WebContents webContents = tab.getWebContents();
+        assert webContents != null;
+        String origin = getOrigin(tab.getUrl());
+        if (origin.isEmpty()) return;
+
+        JSONArray selectors = getRulesForOrigin(origin);
+        getPrefs().edit().remove(origin).apply();
+        executePageScript(webContents, getShowAllScript(selectors), null);
+        Toast.makeText(context, R.string.ursus_element_blocker_restored, Toast.LENGTH_SHORT).show();
+    }
+
+    public static void applyRules(@Nullable Tab tab) {
+        if (!canBlockElements(tab)) return;
+
+        assert tab != null;
+        WebContents webContents = tab.getWebContents();
+        assert webContents != null;
+        String origin = getOrigin(tab.getUrl());
+        if (origin.isEmpty()) return;
+
+        JSONArray selectors = getRulesForOrigin(origin);
+        if (selectors.length() == 0) return;
+
+        executePageScript(webContents, getApplyRulesScript(selectors), null);
+    }
+
+    private static void pollForSelection(
+            Context context, Tab tab, String origin, int attemptsRemaining) {
+        if (attemptsRemaining <= 0 || !canBlockElements(tab)) return;
+
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        executePageScript(
+                webContents,
+                "(function(){var v=sessionStorage.getItem('"
+                        + LAST_SELECTOR_KEY
+                        + "');if(v!==null){sessionStorage.removeItem('"
+                        + LAST_SELECTOR_KEY
+                        + "');return v;}return '';})()",
+                new JavaScriptCallback() {
+                    @Override
+                    public void handleJavaScriptResult(String jsonResult) {
+                        String selector = readJsonString(jsonResult);
+                        if (!selector.isEmpty()) {
+                            if ("__cancelled__".equals(selector)) {
+                                Toast.makeText(
+                                                context,
+                                                R.string.ursus_element_blocker_cancelled,
+                                                Toast.LENGTH_SHORT)
+                                        .show();
+                            } else {
+                                saveRule(origin, selector);
+                                applyRules(tab);
+                                Toast.makeText(
+                                                context,
+                                                R.string.ursus_element_blocker_saved,
+                                                Toast.LENGTH_SHORT)
+                                        .show();
+                            }
+                            return;
+                        }
+                        new Handler(Looper.getMainLooper())
+                                .postDelayed(
+                                        () ->
+                                                pollForSelection(
+                                                        context,
+                                                        tab,
+                                                        origin,
+                                                        attemptsRemaining - 1),
+                                        POLL_DELAY_MS);
+                    }
+                });
+    }
+
+    private static void executePageScript(
+            WebContents webContents, String script, @Nullable JavaScriptCallback callback) {
+        if (webContents.isDestroyed()) return;
+        ManualAdBlockerJni.get().executePageScript(webContents, script, callback);
+    }
+
+    @CalledByNative
+    private static void onEvaluateJavaScriptResult(String jsonResult, JavaScriptCallback callback) {
+        callback.handleJavaScriptResult(jsonResult);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void executePageScript(
+                WebContents webContents, String script, @Nullable JavaScriptCallback callback);
+    }
+
+    private static JSONArray getRulesForOrigin(String origin) {
+        String serialized = getPrefs().getString(origin, "[]");
+        try {
+            return new JSONArray(serialized);
+        } catch (JSONException e) {
+            return new JSONArray();
+        }
+    }
+
+    private static void saveRule(String origin, String selector) {
+        JSONArray selectors = getRulesForOrigin(origin);
+        for (int i = 0; i < selectors.length(); i++) {
+            if (selector.equals(selectors.optString(i))) return;
+        }
+        if (selectors.length() >= MAX_RULES_PER_ORIGIN) selectors.remove(0);
+        selectors.put(selector);
+        getPrefs().edit().putString(origin, selectors.toString()).apply();
+    }
+
+    private static SharedPreferences getPrefs() {
+        return ContextUtils.getApplicationContext().getSharedPreferences(PREFS_NAME, 0);
+    }
+
+    private static String getOrigin(GURL url) {
+        GURL origin = url.getOrigin();
+        return origin == null ? "" : origin.getSpec();
+    }
+
+    private static boolean isSupportedUrl(GURL url) {
+        if (url == null || !url.isValid()) return false;
+        String scheme = url.getScheme();
+        return "http".equals(scheme) || "https".equals(scheme);
+    }
+
+    private static String readJsonString(String jsonResult) {
+        if (jsonResult == null || jsonResult.equals("null")) return "";
+        try {
+            return new JSONArray("[" + jsonResult + "]").optString(0, "");
+        } catch (JSONException e) {
+            return "";
+        }
+    }
+
+    private static String getApplyRulesScript(JSONArray selectors) {
+        return "(function(selectors){"
+                + "const id='ursus-manual-adblock-style';"
+                + "let style=document.getElementById(id);"
+                + "if(!style){style=document.createElement('style');style.id=id;"
+                + "(document.head||document.documentElement).appendChild(style);}"
+                + "style.textContent=selectors.map(s=>s+'{display:none!important;}').join('\\n');"
+                + "function hide(){selectors.forEach(s=>{try{document.querySelectorAll(s).forEach("
+                + "e=>{if(!e.hasAttribute('data-ursus-original-display'))"
+                + "e.setAttribute('data-ursus-original-display',e.style.display||'');"
+                + "e.setAttribute('data-ursus-manual-blocked','1');"
+                + "e.style.setProperty('display','none','important');});}catch(e){}});}"
+                + "hide();"
+                + "if(window.__ursusManualAdBlockObserver)window.__ursusManualAdBlockObserver.disconnect();"
+                + "window.__ursusManualAdBlockObserver=new MutationObserver(hide);"
+                + "window.__ursusManualAdBlockObserver.observe(document.documentElement,"
+                + "{childList:true,subtree:true});"
+                + "})("
+                + selectors
+                + ");";
+    }
+
+    private static String getShowAllScript(JSONArray selectors) {
+        return "(function(selectors){"
+                + "const id='ursus-manual-adblock-style';"
+                + "if(window.__ursusManualAdBlockObserver){window.__ursusManualAdBlockObserver.disconnect();"
+                + "window.__ursusManualAdBlockObserver=null;}"
+                + "const style=document.getElementById(id);if(style)style.remove();"
+                + "function restore(e){if(!e)return;"
+                + "if(e.hasAttribute('data-ursus-original-display')){"
+                + "e.style.display=e.getAttribute('data-ursus-original-display')||'';"
+                + "}else if(e.style&&e.style.display==='none'){e.style.display='';}"
+                + "e.removeAttribute('data-ursus-original-display');"
+                + "e.removeAttribute('data-ursus-manual-blocked');}"
+                + "document.querySelectorAll('[data-ursus-manual-blocked]').forEach(restore);"
+                + "selectors.forEach(s=>{try{document.querySelectorAll(s).forEach(restore);}catch(e){}});"
+                + "})("
+                + selectors
+                + ");";
+    }
+
+    private static String getStartPickerScript(Context context) {
+        return "(function(){"
+                + "if(window.__ursusElementPickerCleanup)window.__ursusElementPickerCleanup();"
+                + "const key='"
+                + LAST_SELECTOR_KEY
+                + "';"
+                + "const prompt="
+                + jsonString(context.getString(R.string.ursus_element_blocker_confirm_hint))
+                + ";"
+                + "const blockLabel="
+                + jsonString(context.getString(R.string.ursus_element_blocker_confirm_block))
+                + ";"
+                + "const cancelLabel="
+                + jsonString(context.getString(R.string.ursus_element_blocker_confirm_cancel))
+                + ";"
+                + "const esc=s=>(window.CSS&&CSS.escape)?CSS.escape(s):String(s).replace(/[^a-zA-Z0-9_-]/g,'\\\\$&');"
+                + "const style=document.createElement('style');style.id='ursus-element-picker-style';"
+                + "style.textContent='.__ursus-picker-outline{outline:3px solid #4cc38a!important;outline-offset:2px!important;}#ursus-picker-panel{position:fixed;left:16px;right:16px;bottom:24px;z-index:2147483647;background:#17201d;color:#fff;border:1px solid #4cc38a;border-radius:10px;padding:12px 14px;font:14px sans-serif;box-shadow:0 4px 18px rgba(0,0,0,.35);}#ursus-picker-message{text-align:center;margin-bottom:10px;}#ursus-picker-actions{display:flex;gap:10px;justify-content:center;}#ursus-picker-actions button{appearance:none;border:1px solid #4cc38a;border-radius:8px;padding:8px 14px;background:#24322d;color:#fff;font:14px sans-serif;}#ursus-picker-block{background:#1f7f43!important;border-color:#88d49f!important;}';"
+                + "document.documentElement.appendChild(style);"
+                + "const panel=document.createElement('div');panel.id='ursus-picker-panel';"
+                + "const message=document.createElement('div');message.id='ursus-picker-message';"
+                + "message.textContent=prompt;"
+                + "const actions=document.createElement('div');actions.id='ursus-picker-actions';"
+                + "const block=document.createElement('button');block.id='ursus-picker-block';"
+                + "block.textContent=blockLabel;"
+                + "const cancelButton=document.createElement('button');cancelButton.id='ursus-picker-cancel';"
+                + "cancelButton.textContent=cancelLabel;"
+                + "actions.appendChild(block);actions.appendChild(cancelButton);"
+                + "panel.appendChild(message);panel.appendChild(actions);"
+                + "document.documentElement.appendChild(panel);"
+                + "let current=null;"
+                + "function cleanup(){if(current)current.classList.remove('__ursus-picker-outline');"
+                + "document.removeEventListener('touchstart',onTouch,true);"
+                + "document.removeEventListener('click',onClick,true);"
+                + "panel.remove();style.remove();window.__ursusElementPickerCleanup=null;}"
+                + "function insidePanel(el){return el&&(el===panel||panel.contains(el));}"
+                + "function selector(el){if(!el||el===document.documentElement||el===document.body)return '';"
+                + "if(el.id)return '#'+esc(el.id);"
+                + "const path=[];while(el&&el.nodeType===1&&el!==document.body){"
+                + "let part=el.localName.toLowerCase();"
+                + "const classes=[...el.classList].filter(c=>!c.startsWith('__ursus-')&&!/[0-9]{4,}/.test(c)).slice(0,2);"
+                + "if(classes.length)part+='.'+classes.map(esc).join('.');"
+                + "let n=1,sib=el;while((sib=sib.previousElementSibling)!=null){if(sib.localName===el.localName)n++;}"
+                + "part+=':nth-of-type('+n+')';path.unshift(part);"
+                + "const joined=path.join('>');try{if(document.querySelectorAll(joined).length===1)return joined;}catch(e){}"
+                + "el=el.parentElement;}return path.join('>');}"
+                + "function pick(x,y){let el=document.elementFromPoint(x,y);"
+                + "if(!el||insidePanel(el))return;"
+                + "if(current)current.classList.remove('__ursus-picker-outline');current=el;"
+                + "current.classList.add('__ursus-picker-outline');}"
+                + "function finish(el){const s=selector(el);cleanup();if(s){try{document.querySelectorAll(s).forEach(e=>{if(!e.hasAttribute('data-ursus-original-display'))e.setAttribute('data-ursus-original-display',e.style.display||'');e.setAttribute('data-ursus-manual-blocked','1');e.style.setProperty('display','none','important');});}catch(e){}sessionStorage.setItem(key,s);}}"
+                + "function cancel(){cleanup();sessionStorage.setItem(key,'__cancelled__');}"
+                + "function onTouch(e){if(!e.changedTouches.length)return;const t=e.changedTouches[0];pick(t.clientX,t.clientY);}"
+                + "function onClick(e){e.preventDefault();e.stopPropagation();"
+                + "if(e.target&&e.target.id==='ursus-picker-cancel'){cancel();return;}"
+                + "if(e.target&&e.target.id==='ursus-picker-block'){finish(current);return;}"
+                + "if(insidePanel(e.target))return;"
+                + "pick(e.clientX,e.clientY);}"
+                + "document.addEventListener('touchstart',onTouch,true);"
+                + "document.addEventListener('click',onClick,true);"
+                + "window.__ursusElementPickerCleanup=cleanup;"
+                + "})()";
+    }
+
+    private static String jsonString(String value) {
+        return JSONObject.quote(value);
+    }
+}
